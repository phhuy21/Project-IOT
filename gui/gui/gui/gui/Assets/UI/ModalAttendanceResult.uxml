<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="ModalOverlay" class="modal-overlay" style="display: none;">
        <ui:VisualElement class="modal-card" style="width: 450px; flex-direction: column;">
            
            <!-- Header with Close Button -->
            <ui:VisualElement style="flex-direction: row; justify-content: flex-end; width: 100%;">
                <ui:Button name="BtnCloseModal" text="✕" class="btn-close-icon" />
            </ui:VisualElement>

            <!-- Main Content: Left (Avatar) - Right (Info) -->
            <ui:VisualElement style="flex-direction: row; margin-top: -10px; margin-bottom: 20px;">
                
                <!-- Left: Square Avatar -->
                <ui:VisualElement class="avatar-square-container">
                    <ui:VisualElement name="ModalAvatarImage" style="width: 100%; height: 100%; border-radius: 12px; display: none; -unity-background-scale-mode: scale-and-crop;" />
                    <ui:Label name="ModalAvatarChar" text="?" style="font-size: 50px; color: white; -unity-font-style: bold; position: absolute;" />
                </ui:VisualElement>

                <!-- Right: Info -->
                <ui:VisualElement style="flex-grow: 1; justify-content: center; margin-left: 20px;">
                    <ui:Label name="ModalName" text="Đang nhận diện..." style="font-size: 22px; -unity-font-style: bold; color: #2D3436; white-space: normal;" />
                    <ui:Label name="ModalMssv" text="MSSV: ---" style="font-size: 16px; color: #636E72; margin-top: 5px;" />
                    
                    <!-- Status Badge -->
                    <ui:VisualElement name="StatusBadge" style="flex-direction: row; align-items: center; margin-top: 15px;">
                        <ui:Label name="ModalStatusIcon" text="✓" style="font-size: 20px; margin-right: 8px;" />
                        <ui:Label name="ModalStatusText" text="Đang xử lý..." style="font-size: 16px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    
                    <!-- Time -->
                    <ui:Label name="ModalTime" text="08:30:00" style="font-size: 14px; color: #B2BEC3; margin-top: 10px;" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
