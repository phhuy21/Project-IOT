                                <ui:TextField name="InpTimeStart" value="07:00" style="height: 40px; font-size: 16px; width: 120px;" />
                            </ui:VisualElement>
                            <ui:Button name="BtnSaveSettings" text="💾 Lưu Cài Đặt" class="btn-w220 btn-h40" style="align-self: flex-start; background-color: #00b894; color: white; border-radius: 8px; border-width: 0; font-size: 14px; -unity-font-style: bold; margin-top: 10px;" />
                        </ui:VisualElement>

                        <!-- Section: Account -->
    <ui:VisualElement style="margin-bottom: 20px; padding: 20px; background-color: #f8f9fa; border-radius: 10px;">
                            <ui:Label text="🔐 Tài khoản" style="font-size: 16px; -unity-font-style: bold; color: #2d3436; margin-bottom: 15px;" />
                            <ui:Button name="BtnChangePasswordSettings" text="🔑 Đổi mật khẩu" class="btn-w220 btn-h40" style="background-color: #0984e3; color: white; border-radius: 8px; border-width: 0; font-size: 14px; -unity-font-style: bold;" />
                        </ui:VisualElement>

                        <!-- Section: Google Sheets -->
                        <ui:VisualElement style="margin-bottom: 20px; padding: 20px; background-color: #f8f9fa; border-radius: 10px;">
                            <ui:Label text="📄 Google Sheets" style="font-size: 16px; -unity-font-style: bold; color: #2d3436; margin-bottom: 10px;" />
                            <ui:Label text="Kết nối Google để đồng bộ điểm danh lên Google Sheets." style="color: #636E72; font-size: 13px; margin-bottom: 12px;" />

                            <ui:VisualElement style="flex-direction: row; align-items: center;">
                                <ui:Button name="BtnConnectGoogle" text="🔗 Kết nối Google" class="btn-w220 btn-h40"
                                           style="background-color: #00b894; color: white; border-radius: 8px; border-width: 0; font-size: 14px; -unity-font-style: bold; margin-right: 10px;" />
                                <ui:Button name="BtnOpenGSheet" text="📄 Mở Google Sheet" class="btn-w220 btn-h40"
                                           style="display: none; background-color: #0984e3; color: white; border-radius: 8px; border-width: 0; font-size: 14px; -unity-font-style: bold;" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Section: Data Management - REMOVED -->

                        <!-- Section: Contact / Support -->
                        <ui:VisualElement style="margin-bottom: 20px; padding: 20px; background-color: #fff3e0; border-radius: 10px; border-left-width: 4px; border-left-color: #ff9800;">
                            <ui:Label text="📞 Liên hệ hỗ trợ" style="font-size: 16px; -unity-font-style: bold; color: #2d3436; margin-bottom: 15px;" />
                            <ui:Label text="Nếu có thắc mắc, vui lòng liên hệ:" style="color: #636E72; margin-bottom: 10px; font-size: 13px;" />
                            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 8px;">
                                <ui:Label text="📱 Zalo:" style="color: #2d3436; font-size: 14px; width: 80px; -unity-font-style: bold;" />
                                <ui:Label text="0355587757" style="color: #0984e3; font-size: 14px;" />
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; align-items: center;">
                                <ui:Label text="📧 Gmail:" style="color: #2d3436; font-size: 14px; width: 80px; -unity-font-style: bold;" />
                                <ui:Label text="huypham723012@gmail.com" style="color: #0984e3; font-size: 14px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Section: App Info -->
                        <ui:VisualElement style="padding: 15px; background-color: #ecf0f1; border-radius: 10px; align-items: center;">
                            <ui:Label text="ℹ️ Thông tin ứng dụng" style="font-size: 14px; -unity-font-style: bold; color: #636e72; margin-bottom: 8px;" />
                            <ui:Label text="Hệ thống Điểm danh AI - HCMUTE" style="font-size: 13px; color: #2d3436;" />
                            <ui:Label text="Phiên bản: 1.0.0" style="font-size: 12px; color: #636e72; margin-top: 3px;" />
                            <ui:Label text="© 2026 Developed by Pham Gia Huy" style="font-size: 11px; color: #b2bec3; margin-top: 5px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement> <!-- End Info Column -->
            </ui:VisualElement> <!-- End Workspace -->
            
            <!-- FLOATING CAMERA PREVIEW (Overlay on content-area) -->
            <ui:VisualElement name="CameraPreview" class="camera-panel" style="display: none;">
                <ui:Label name="LblStatus" text="Trạng thái: Đang chờ..." style="color: white; background-color: rgba(0, 0, 0, 0.5); padding: 10px; border-radius: 8px; align-self: flex-start;" />
            </ui:VisualElement>

        </ui:VisualElement> <!-- End Content Area -->
    </ui:VisualElement> <!-- End Main Container -->
            
    <!-- POPUP MODAL CONTAINER (Overlay entire screen - Root Level) -->
    <ui:VisualElement name="ModalContainer" style="position: absolute; width: 100%; height: 100%; display: none; align-items: center; justify-content: center; pointer-events: box-none;">
        <!-- Content will be instantiated here and centered by this container or its children -->
    </ui:VisualElement>

    <!-- LOGIN SCREEN OVERLAY (HCM-UTE Style) -->
    <ui:VisualElement name="LoginOverlay" style="position: absolute; width: 100%; height: 100%; background-color: #f1f2f6; align-items: center; justify-content: center; display: flex;">
        
        <!-- Header Brand -->
        <ui:VisualElement style="align-items: center; margin-bottom: 30px;">
            <!-- Logo Placeholder (Circle Blue) -->
            <ui:VisualElement name="ContainerLogo" style="width: 80px; height: 80px; background-color: #0c4da2; border-radius: 50%; justify-content: center; align-items: center; margin-bottom: 10px;">
                <ui:Label text="UTE" style="color: white; -unity-font-style: bold; font-size: 18px;" />
            </ui:VisualElement>
            
            <ui:Label text="HCM-UTE" style="color: #0c4da2; font-size: 24px; -unity-font-style: bold; margin-bottom: 5px;" />
            <ui:Label text="ĐẠI HỌC CÔNG NGHỆ KỸ THUẬT TP.HCM" style="color: #002b49; font-size: 18px; -unity-font-style: bold; text-transform: uppercase;" />
        </ui:VisualElement>

        <!-- Login Card -->
        <ui:VisualElement style="width: 450px; background-color: white; border-radius: 4px; padding: 40px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
            
            <ui:Label text="ĐĂNG NHẬP" style="color: #0c4da2; font-size: 24px; -unity-font-style: bold; margin-bottom: 5px;" />
            <ui:Label text="Cổng thông tin đào tạo" style="color: #636e72; font-size: 14px; margin-bottom: 30px;" />

            <!-- Input: Username -->
            <ui:VisualElement style="margin-bottom: 20px;">
                <ui:Label text="Tên đăng nhập" style="color: #2d3436; font-size: 13px; margin-bottom: 5px; -unity-font-style: bold;" />
                <ui:VisualElement style="background-color: white; border-width: 1px; border-color: #ced4da; border-radius: 4px; padding: 0; height: 40px; justify-content: center;">
                    <ui:TextField name="InpLoginUser" value="admin" style="font-size: 14px; background-color: transparent; border-width: 0; margin-left: 5px; margin-right: 5px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Input: Email (For Register) -->
            <ui:VisualElement name="ContainerEmail" style="margin-bottom: 20px; display: none;">
                <ui:Label text="Email (Gmail)" style="color: #2d3436; font-size: 13px; margin-bottom: 5px; -unity-font-style: bold;" />
                <ui:VisualElement style="background-color: white; border-width: 1px; border-color: #ced4da; border-radius: 4px; padding: 0; height: 40px; justify-content: center;">
                    <ui:TextField name="InpLoginEmail" style="font-size: 14px; background-color: transparent; border-width: 0; margin-left: 5px; margin-right: 5px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Input: Password -->
            <ui:VisualElement style="margin-bottom: 30px;">
                <ui:Label text="Mật khẩu" style="color: #2d3436; font-size: 13px; margin-bottom: 5px; -unity-font-style: bold;" />
                <ui:VisualElement style="background-color: white; border-width: 1px; border-color: #ced4da; border-radius: 4px; padding: 0; height: 40px; justify-content: center;">
                    <ui:TextField name="InpLoginPass" value="123456" password="true" style="font-size: 14px; background-color: transparent; border-width: 0; margin-left: 5px; margin-right: 5px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Button: Login -->
            <ui:Button name="BtnLoginInfo" text="Đăng nhập" style="height: 40px; background-color: #005a8d; color: white; border-radius: 4px; font-size: 14px; -unity-font-style: bold; border-width: 0; margin-bottom: 10px;" />

            <!-- Button: Google Login -->
            <ui:Button name="BtnLoginGoogle" style="height: 40px; background-color: white; border-radius: 4px; border-width: 1px; border-color: #ced4da; margin-bottom: 20px;">
                <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: center;">
                    <ui:Label text="G" style="font-size: 18px; -unity-font-style: bold; margin-right: 10px; color: #4285f4;" />
                    <ui:Label text="Đăng nhập với Google" style="font-size: 14px; -unity-font-style: bold; color: #2d3436;" />
                </ui:VisualElement>
            </ui:Button>

            <!-- Footer Links -->
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-top: 10px;">
                <ui:Label name="LblForgotPassword" text="Quên mật khẩu?" style="color: #636e72; font-size: 13px; cursor: link;" />
                <ui:Label name="LblRegister" text="Đăng ký tài khoản" style="color: #0c4da2; font-size: 13px; -unity-font-style: bold; cursor: link;" />
            </ui:VisualElement>

        </ui:VisualElement>

        <ui:Label text="© 2026 Developed by Pham Gia Huy" style="position: absolute; bottom: 20px; color: #b2bec3; font-size: 12px;" />

    <!-- FORGOT PASSWORD MODAL (Hidden by default) -->
    <ui:VisualElement name="ModalForgotPassword" style="position: absolute; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; display: none;">
        <ui:VisualElement style="width: 400px; background-color: white; border-radius: 8px; padding: 20px;">
            <ui:Label text="QUÊN MẬT KHẨU" style="color: #0c4da2; font-size: 18px; -unity-font-style: bold; margin-bottom: 20px; align-self: center;" />
            
            <!-- STEP 1: SEND OTP -->
            <ui:VisualElement name="StepSendOtp">
                <ui:Label text="Nhập Email của bạn:" style="margin-bottom: 5px;" />
                <ui:TextField name="InpForgotEmail" style="height: 40px; margin-bottom: 15px;" />
                <ui:Button name="BtnSendOtp" text="Gửi mã OTP" style="height: 40px; background-color: #0c4da2; color: white; -unity-font-style: bold;" />
            </ui:VisualElement>

            <!-- STEP 2: VERIFY OTP & RESET -->
            <ui:VisualElement name="StepResetPass" style="display: none;">
                <ui:Label text="Nhập mã OTP (6 số):" style="margin-bottom: 5px;" />
                <ui:TextField name="InpForgotOtp" style="height: 40px; margin-bottom: 10px;" />
                <ui:Label text="Mật khẩu mới:" style="margin-bottom: 5px;" />
                <ui:TextField name="InpForgotNewPass" password="true" style="height: 40px; margin-bottom: 15px;" />
                <ui:Button name="BtnConfirmReset" text="Xác nhận đổi mật khẩu" style="height: 40px; background-color: #27ae60; color: white; -unity-font-style: bold;" />
            </ui:VisualElement>
            
            <ui:Button name="BtnCloseForgot" text="Đóng" style="height: 35px; background-color: transparent; border-width: 0; color: #7f8c8d; margin-top: 10px;" />
        </ui:VisualElement>
    </ui:VisualElement>

    </ui:VisualElement>
    <!-- CHANGE PASSWORD MODAL (Hidden by default) -->
    <ui:VisualElement name="ModalChangePassword" style="position: absolute; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; display: none;">
        <ui:VisualElement style="width: 400px; background-color: white; border-radius: 8px; padding: 20px;">
            <ui:Label text="ĐỔI MẬT KHẨU" style="color: #0c4da2; font-size: 18px; -unity-font-style: bold; margin-bottom: 20px; align-self: center;" />
            
            <ui:Label text="Mật khẩu hiện tại:" style="margin-bottom: 5px;" />
            <ui:TextField name="InpOldPass" password="true" style="height: 40px; margin-bottom: 10px;" />
            
            <ui:Label text="Mật khẩu mới:" style="margin-bottom: 5px;" />
            <ui:TextField name="InpNewPass" password="true" style="height: 40px; margin-bottom: 10px;" />

            <ui:Label text="Xác nhận mật khẩu mới:" style="margin-bottom: 5px;" />
            <ui:TextField name="InpConfirmNewPass" password="true" style="height: 40px; margin-bottom: 20px;" />

            <ui:Button name="BtnSubmitChangePass" text="Xác nhận" style="height: 40px; background-color: #0c4da2; color: white; -unity-font-style: bold; margin-bottom: 10px;" />
            <ui:Button name="BtnCloseChangePass" text="Hủy bỏ" style="height: 35px; background-color: transparent; border-width: 0; color: #7f8c8d;" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- MANUAL CHECKIN MODAL (Redesigned) -->
    <ui:VisualElement name="ModalManualCheckin" style="position: absolute; width: 100%; height: 100%; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center; display: none;">
        <ui:VisualElement name="ManualCheckinCard" style="width: 800px; height: 80%; max-height: 700px; background-color: white; border-radius: 16px; flex-direction: column; overflow: hidden;">
            
            <!-- HEADER -->
            <ui:VisualElement style="flex-shrink: 0; flex-direction: row; justify-content: space-between; align-items: center; padding: 20px 25px; background-color: #0984e3;">
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:Label text="📝" style="font-size: 24px; margin-right: 12px;" />
                    <ui:Label text="Điểm danh thủ công" style="color: white; font-size: 22px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:Button name="BtnCloseManualCheckin" text="✕" style="width: 40px; height: 40px; background-color: rgba(255,255,255,0.2); color: white; border-radius: 20px; border-width: 0; font-size: 20px;" />
            </ui:VisualElement>

            <!-- CONTROLS: Search + Status (Stacked for clarity) -->
            <ui:VisualElement style="flex-shrink: 0; padding: 20px 25px; background-color: #f8f9fa; border-bottom-width: 1px; border-bottom-color: #e9ecef;">
                <!-- Row 1: Search -->
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 12px;">
                    <ui:Label text="🔍 Tìm kiếm:" style="font-size: 14px; color: #2d3436; width: 100px; -unity-font-style: bold;" />
                    <ui:VisualElement style="flex-grow: 1; background-color: white; border-width: 1px; border-color: #ced4da; border-radius: 8px; padding: 0 15px; height: 42px; justify-content: center;">
                        <ui:TextField name="InpSearchManualCheckin" style="flex-grow: 1; font-size: 14px; background-color: transparent; border-width: 0;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                
                <!-- Row 2: Status Dropdown -->
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:Label text="📋 Trạng thái:" style="font-size: 14px; color: #2d3436; width: 100px; -unity-font-style: bold;" />
                    <ui:DropdownField name="DrpManualStatus" style="flex-grow: 1; height: 42px; max-width: 250px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- INFO BAR -->
            <ui:VisualElement style="flex-shrink: 0; padding: 10px 25px; background-color: #e3f2fd; flex-direction: row; align-items: center;">
                <ui:Label text="💡" style="font-size: 14px; margin-right: 8px;" />
                <ui:Label text="Click vào dòng hoặc checkbox để chọn sinh viên" style="font-size: 13px; color: #1976d2;" />
            </ui:VisualElement>

            <!-- STUDENT LIST -->
            <ui:ScrollView name="ManualCheckinStudentList" style="flex-grow: 1; padding: 10px 25px;">
                <!-- Populated by C# -->
            </ui:ScrollView>

            <!-- FOOTER -->
            <ui:VisualElement style="flex-shrink: 0; flex-direction: row; justify-content: space-between; align-items: center; padding: 18px 25px; background-color: #f8f9fa; border-top-width: 1px; border-top-color: #e9ecef;">
                <ui:Label name="LblManualCheckinCount" text="✅ Đã chọn: 0 sinh viên" style="font-size: 15px; color: #2d3436; -unity-font-style: bold;" />
                <ui:Button name="BtnConfirmManualCheckin" text="✔ Xác nhận điểm danh" style="height: 48px; padding: 0 35px; background-color: #00b894; color: white; border-radius: 10px; border-width: 0; font-size: 16px; -unity-font-style: bold;" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>

    <!-- CLASS PICKER MODAL -->
    <ui:VisualElement name="ClassPickerOverlay" class="classpicker-overlay is-hidden">
        <ui:VisualElement name="ClassPickerCard" class="classpicker-card">
            <ui:Label name="ClassPickerTitle" text="🎓 Chọn Lớp Học" class="classpicker-title" />
            <ui:ScrollView name="ClassPickerList" class="classpicker-scroll" horizontal-scroller-visibility="Hidden" />
            <ui:Button name="BtnClassPickerClose" text="Đóng" class="classpicker-close" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- LOGIN OVERLAY (Added) -->
    <ui:VisualElement name="LoginContainer" style="position: absolute; width: 100%; height: 100%; background-color: rgba(255, 255, 255, 0.95); justify-content: center; align-items: center; display: none;">
        <ui:VisualElement style="background-color: white; padding: 40px; border-radius: 20px; align-items: center; border-width: 1px; border-color: #ddd;">
             <ui:Label text="ĐĂNG NHẬP" style="font-size: 24px; -unity-font-style: bold; color: #333; margin-bottom: 30px;" />
             <ui:Button name="BtnLoginGoogle" text="🔐 Đăng nhập với Google"
                   style="height: 44px; width: 250px; background-color: #4285F4; color: white; border-radius: 8px; font-size: 14px; -unity-font-style: bold; border-width: 0;" />
        </ui:VisualElement>
    </ui:VisualElement>

</ui:UXML>
