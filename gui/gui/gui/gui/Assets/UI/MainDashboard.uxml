<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainDashboard.uss?fileID=7433441132597879392&amp;guid=8608484933eefd64cbfbb921a66bf232&amp;type=3#MainDashboard" />
    <ui:VisualElement class="main-container" style="background-color: rgb(242, 247, 248); display: flex; visibility: visible; overflow: visible; opacity: 1; flex-wrap: nowrap;">
        <ui:VisualElement name="Sidebar" class="sidebar-wide">
            <ui:VisualElement class="logo-container" style="flex-direction: row; align-items: center; margin-bottom: 40px; margin-left: 10px;">
                <ui:VisualElement name="SidebarLogo" style="width: 36px; height: 36px; margin-right: 10px; border-radius: 8px; background-color: #f0f0f0;" />
                <ui:Label text="HCM-UTE" class="logo-text" style="margin-bottom: 0; margin-left: 0;" />
                <ui:VisualElement style="flex-grow: 1;" />
                <ui:Button name="BtnSidebarToggle" class="sidebar-toggle" text="⟪" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1;">
                <ui:Button name="BtnHome" class="menu-item active">
                    <ui:VisualElement class="menu-icon icon-home" />
                    <ui:Label text="Trang chủ" class="menu-text" />
                </ui:Button>

                <ui:Button name="BtnRegister" class="menu-item">
                    <ui:VisualElement class="menu-icon icon-register" />
                    <ui:Label text="Đăng ký" class="menu-text" />
                </ui:Button>
                <ui:Button name="BtnAttendance" class="menu-item">
                    <ui:VisualElement class="menu-icon icon-attendance" />
                    <ui:Label text="Điểm danh" class="menu-text" />
                </ui:Button>
                <ui:Button name="BtnClassList" class="menu-item">
                    <ui:VisualElement class="menu-icon icon-classlist" />
                    <ui:Label text="Danh sách lớp" class="menu-text" />
                </ui:Button>
                <ui:Button name="BtnStats" class="menu-item">
                    <ui:VisualElement class="menu-icon icon-stats" />
                    <ui:Label text="Thống kê" class="menu-text" />
                </ui:Button>
                <ui:Button name="BtnSchedule" class="menu-item">
                    <ui:VisualElement class="menu-icon icon-schedule" />
                    <ui:Label text="Lịch dạy" class="menu-text" />
                </ui:Button>
                <ui:Button name="BtnSettings" class="menu-item">
                    <ui:VisualElement class="menu-icon icon-settings" />
                    <ui:Label text="Cài đặt" class="menu-text" />
                </ui:Button>
            </ui:VisualElement>

            <ui:Button name="BtnLogout" class="menu-item">
                <ui:VisualElement class="menu-icon icon-logout" />
                <ui:Label text="Đăng xuất" class="menu-text" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement class="content-area">
            <ui:VisualElement class="header">
                <ui:Label text="Hệ Thống Điểm Danh AI" class="header-title" />
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:Label name="LblDateWeek" text="Thứ Năm, 25/12 - Tuần 16" class="header-date" style="margin-right: 20px; font-size: 16px; color: #636e72;" />
                    <ui:Label name="LblClock" text="08:30:00" style="font-size: 20px; color: rgb(99, 110, 114); -unity-text-align: upper-center;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="workspace">
                <ui:VisualElement class="info-column">
                    <!-- 1. HOME MODE (Dashboard Redesign) -->
                    <ui:VisualElement name="MainContentContainer" style="flex-grow: 1;">
                        
                        <!-- DATE PICKER ROW -->
                        <ui:VisualElement style="flex-direction: row; justify-content: flex-end; margin-bottom: 10px; align-items: center;">
                            <ui:Label text="📅 Xem ngày:" style="font-size: 14px; color: #636e72; margin-right: 10px;" />
                            <ui:DropdownField name="DrpDaySelector" class="btn-dropdown" style="width: 150px;" />
                        </ui:VisualElement>

                        <!-- ROW 1: STATS OVERVIEW -->
                        <ui:VisualElement class="dashboard-row" style="height: 140px; margin-bottom: 20px;">
                            <!-- Card 1: Total Students -->
                            <ui:VisualElement class="dashboard-card card-blue">
                                <ui:Label text="Tổng sinh viên" class="stat-label" />
                                <ui:Label name="LblStatTotal" text="--" class="stat-value" />
                                <ui:Label name="LblCurrentClass" text="Lớp: --" class="stat-sub" />
                                <ui:VisualElement class="stat-icon-bg bg-blue">
                                    <ui:Label text="👥" class="stat-icon" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Card 2: Class Switcher -->
                            <ui:VisualElement name="CardClassSwitcher" class="dashboard-card card-green" style="justify-content: center; align-items: center; cursor: pointer;">
                                <ui:Label text="🔄" style="font-size: 32px; margin-bottom: 5px;" />
                                <ui:Label text="Đổi lớp" class="stat-label" style="-unity-text-align: middle-center;" />
                                <ui:Label name="LblClassSwitcherSub" text="Chưa chọn lớp" class="stat-sub" style="-unity-text-align: middle-center; color: #888;" />
                            </ui:VisualElement>

                            <!-- Card 3: Absent (Warning) -->
                            <ui:VisualElement name="CardAbsent" class="dashboard-card card-orange" style="cursor: pointer;">
                                <ui:Label text="Vắng" class="stat-label" />
                                <ui:Label name="LblStatAbsent" text="--" class="stat-value color-orange" />
                                <ui:Label text="Cần chú ý" class="stat-sub" />
                                <ui:VisualElement class="stat-icon-bg bg-orange">
                                    <ui:Label text="⚠️" class="stat-icon" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Card 4: Late (Danger) -->
                            <ui:VisualElement class="dashboard-card card-red">
                                <ui:Label text="Đi trễ" class="stat-label" />
                                <ui:Label name="LblStatLate" text="--" class="stat-value color-red" />
                                <ui:Label name="LblStatLateSub" text="Sau 07:00" class="stat-sub" />
                                <ui:VisualElement class="stat-icon-bg bg-red">
                                    <ui:Label text="⏰" class="stat-icon" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- ROW 2: CHARTS & ACTIONS -->
                        <ui:VisualElement class="dashboard-row" style="height: 280px; margin-bottom: 20px;">
                            <!-- LEFT: Attendance Trend (Fake Bar Chart) -->
                            <ui:VisualElement class="dashboard-card" style="flex-grow: 2; margin-right: 20px;">
                                <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                                    <ui:Label text="Biểu đồ tham gia" class="card-title" />
                                    <ui:DropdownField name="DrpChartWeekSelector" class="btn-dropdown" style="width: 120px;" />
                                </ui:VisualElement>
                                <!-- Fake Chart Container -->
                                <ui:VisualElement class="chart-container">
                                    <ui:VisualElement name="TrendChartCanvas" style="width: 100%; height: 100%;" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- RIGHT: Quick Actions & Pie Chart -->
                            <ui:VisualElement class="dashboard-card" style="flex-grow: 1; min-width: 280px;">
                                <ui:Label text="Thao tác nhanh" class="card-title" style="margin-bottom: 20px;" />
                                
                                <ui:Button name="BtnQuickAttendance" class="btn-action-primary">
                                    <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: center; width: 100%;">
                                        <ui:Label text="📸" style="font-size: 20px; margin-right: 8px;" />
                                        <ui:Label text="Bắt đầu điểm danh" style="font-size: 14px; -unity-font-style: bold;" />
                                    </ui:VisualElement>
                                </ui:Button>

                                <ui:Button name="BtnQuickAddStudent" class="btn-action-secondary">
                                    <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: center; width: 100%;">
                                        <ui:Label text="👤" style="font-size: 18px; margin-right: 8px;" />
                                        <ui:Label text="Thêm sinh viên mới" style="font-size: 14px; -unity-font-style: bold;" />
                                    </ui:VisualElement>
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- ROW 3: RECENT ACTIVITIES / SCHEDULE -->
                        <ui:VisualElement class="dashboard-card" style="flex-grow: 1; min-height: 180px; max-height: 220px;">
                            <ui:Label text="Lịch trình hôm nay" class="card-title" />
                            <ui:VisualElement class="table-header">
                                <ui:Label text="Thời gian" class="col-time" />
                                <ui:Label text="Môn học" class="col-subject" />
                                <ui:Label text="Phòng" class="col-room" />
                                <ui:Label text="Trạng thái" class="col-status" />
                            </ui:VisualElement>
                            <!-- Dynamic Container for Today's Schedule -->
                            <ui:ScrollView name="TodayScheduleContainer" horizontal-scroller-visibility="Hidden" style="flex-grow: 1;">
                                <!-- Will be populated by C# from schedule data -->
                                <ui:Label name="LblNoScheduleToday" text="Chưa có lịch học hôm nay. Vào tab Lịch dạy để thêm." style="color: #636e72; font-size: 13px; padding: 20px; -unity-text-align: middle-center;" />
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>



                    <!-- NEW ATTENDANCE MODE (Merged with History) -->
                    <ui:VisualElement name="AttendanceContainer" style="display: none; flex-grow: 1;">
                        
                        <!-- Header Actions -->
                        <ui:VisualElement class="card" style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                            <ui:Label text="Chế độ Điểm danh" style="font-size: 20px; -unity-font-style: bold;" />
                            <ui:VisualElement style="flex-direction: row;">
                                <ui:Button name="BtnManualCheckin" class="btn-w220 btn-h40" text="📝 Điểm danh thủ công" style="padding: 0 20px; background-color: #0984E3; color: white; border-radius: 8px; border-width: 0; font-size: 14px; -unity-font-style: bold; margin-right: 10px;" />
                                <ui:Button name="BtnExportAttendanceExcel" class="btn-w220 btn-h40" text="📤 Xuất Excel" style="padding: 0 20px; background-color: #6c5ce7; color: white; border-radius: 8px; border-width: 0; font-size: 14px; -unity-font-style: bold; margin-right: 10px;" />
                                <ui:Button name="BtnFinalizeSession" class="btn-w220 btn-h40" text="✅ Chốt buổi" style="padding: 0 20px; background-color: #fdcb6e; color: #2d3436; border-radius: 8px; border-width: 0; font-size: 14px; -unity-font-style: bold; margin-right: 10px;" />
                                <ui:Button name="BtnToggleCameraAttendance" class="btn-w220 btn-h40" text="📷 BẬT CAMERA" style="padding: 0 20px; background-color: rgb(0, 184, 148); color: white; border-radius: 8px; border-width: 0; font-size: 14px; -unity-font-style: bold;" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- FULL WIDTH: HISTORY LOG -->
                        <ui:VisualElement class="card" style="flex-grow: 1; padding: 15px;">
                            <ui:Label text="📋 Nhật ký điểm danh" class="card-title" style="margin-bottom: 15px; font-size: 18px;" />
                            
                            <!-- Log Header -->
                            <ui:VisualElement class="log-header-row" style="background-color: #f1f2f6; border-radius: 6px; padding: 10px; flex-direction: row;">
                                <ui:Label text="Sinh viên" style="flex: 2; -unity-font-style: bold; color: #636e72; font-size: 14px;" />
                                <ui:Label text="MSSV" style="flex: 1; -unity-font-style: bold; color: #636e72; font-size: 14px;" />
                                <ui:Label text="Thời gian" style="flex: 1; -unity-font-style: bold; color: #636e72; font-size: 14px;" />
                                <ui:Label text="Ngày" style="flex: 1; -unity-font-style: bold; color: #636e72; font-size: 14px;" />
                                <ui:Label text="Trạng thái" style="flex: 1; -unity-font-style: bold; color: #636e72; font-size: 14px;" />
                            </ui:VisualElement>

                            <!-- Log List -->
                            <ui:ListView name="MainListView" item-height="55" class="log-list-view" style="flex-grow: 1; margin-top: 10px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="StudentListContainer" class="card-white" style="display: none; height: 100%; padding: 20px;">
                        <!-- Header Row with Title and Actions -->
                        <ui:VisualElement style="flex-direction: row; justify-content: flex-start; align-items: center; margin-bottom: 20px; padding-bottom: 15px; border-bottom-width: 1px; border-color: rgba(0,0,0,0.08);">
                            <ui:VisualElement>
                                <ui:Label text="📋 Danh sách sinh viên" style="font-size: 22px; -unity-font-style: bold; color: #2d3436;" />
                                <ui:Label text="Quản lý danh sách lớp học" style="font-size: 13px; color: #636E72; margin-top: 4px;" />
                            </ui:VisualElement>

                            <!-- Spacer pushes buttons to right -->
                            <ui:VisualElement style="flex-grow: 1;" />

                            <ui:Button name="BtnImportStudent" style="flex-direction: row; align-items: center; padding: 12px 20px; background-color: #6c5ce7; border-radius: 10px; border-width: 0;">
                                <ui:Label text="📂" style="font-size: 18px; margin-right: 8px; color: white;" />
                                <ui:Label text="Nhập từ Excel" style="font-size: 14px; color: white; -unity-font-style: bold;" />
                            </ui:Button>

                            <ui:Button name="BtnConnectGoogle" style="flex-direction: row; align-items: center; padding: 12px 20px; background-color: #0984e3; border-radius: 10px; border-width: 0; margin-left: 10px;">
                                <ui:Label text="🔗" style="font-size: 18px; margin-right: 8px; color: white;" />
                                <ui:Label text="Kết nối Google" style="font-size: 14px; color: white; -unity-font-style: bold;" />
                            </ui:Button>

                            <!-- Open Google Sheet -->
                            <ui:Button name="BtnOpenGoogleSheetStudentList" style="flex-direction: row; align-items: center; padding: 12px 20px; background-color: #ffffff; border-radius: 10px; border-width: 1px; border-color: #ced4da; margin-left: 10px;">
                                <ui:Label text="📄" style="font-size: 18px; margin-right: 8px; color: #2d3436;" />
                                <ui:Label text="Mở Google Sheet" style="font-size: 14px; color: #2d3436; -unity-font-style: bold;" />
                            </ui:Button>

                            <ui:Button name="BtnClearAllStudents" style="flex-direction: row; align-items: center; padding: 12px 20px; background-color: #e74c3c; border-radius: 10px; border-width: 0; margin-left: 10px;">
                                <ui:Label text="🗑️" style="font-size: 18px; margin-right: 8px; color: white;" />
                                <ui:Label text="Xóa tất cả" style="font-size: 14px; color: white; -unity-font-style: bold;" />
                            </ui:Button>
                        </ui:VisualElement>
                        <!-- Search Bar -->
                        <ui:VisualElement style="flex-direction: row; margin-bottom: 15px; align-items: center;">
                            <ui:Label text="🔍" style="font-size: 18px; margin-right: 10px; color: #636e72;" />
                            <ui:VisualElement style="flex: 1; background-color: white; border-width: 1px; border-color: #ced4da; border-radius: 8px; height: 40px; padding: 0 15px; justify-content: center;">
                                <ui:TextField name="InpSearchStudent" placeholder-text="Tìm kiếm sinh viên (Tên, MSSV...)" style="font-size: 14px; background-color: transparent; border-width: 0;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <!-- Student Header Row -->
                        <ui:VisualElement style="background-color: #f1f2f6; border-radius: 6px; padding: 10px; flex-direction: row; margin-bottom: 8px;">
                            <ui:Label text="STT" style="width: 55px; -unity-font-style: bold; color: #636e72; font-size: 14px; unity-text-align: middle-center;" />
                            <ui:Label text="Họ và Tên" style="flex: 2; -unity-font-style: bold; color: #636e72; font-size: 14px;" />
                            <ui:Label text="MSSV" style="width: 100px; -unity-font-style: bold; color: #636e72; font-size: 14px;" />
                            <ui:Label text="Trạng thái" style="width: 120px; -unity-font-style: bold; color: #636e72; font-size: 14px; unity-text-align: middle-center;" />
                            <ui:Label text="" style="width: 90px;" />
                        </ui:VisualElement>
                        <!-- List View (now ScrollView for manual control) -->
                        <ui:ScrollView name="StudentListScrollView" style="flex-grow: 1;">
                            <ui:VisualElement name="StudentListContent" style="flex-direction: column;" />
                        </ui:ScrollView>
                    </ui:VisualElement>

                    <!-- 4. STATS MODE -->
                    <ui:VisualElement name="StatsContainer" style="display: none; flex-grow: 1; flex-direction: column;">
                        
                        <!-- CLASS FILTER (Replace Year/Semester/Phase UI) -->
                        <ui:VisualElement name="StatsClassBar" class="term-bar">
                            <ui:VisualElement class="term-field" style="width: auto; flex-grow: 1;">
                                <ui:Label text="Lớp" class="term-label" />
                                <ui:VisualElement style="flex-direction: row; align-items: center;">
                                    <ui:Button name="BtnStatsChangeClass" text="🔄 Đổi lớp" class="term-dropdown" style="width: 140px; margin-right: 12px;" />
                                    <ui:Label name="LblStatsSelectedClass" text="Chưa chọn lớp" style="color: #636e72; font-size: 13px;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- TERM / WEEK FILTER (Year - Semester - Week) - HIDDEN -->
                        <ui:VisualElement name="TermWeekBar" class="term-bar" style="display: none;">
                            <ui:VisualElement class="term-field">
                                <ui:Label text="Năm học" class="term-label" />
                                <ui:DropdownField name="DrpSchoolYear" class="term-dropdown" />
                            </ui:VisualElement>

                            <ui:VisualElement class="term-field">
                                <ui:Label text="Học kỳ" class="term-label" />
                                <ui:DropdownField name="DrpSemester" class="term-dropdown" />
                            </ui:VisualElement>

                            <ui:VisualElement class="term-field">
                                <ui:Label text="Tuần" class="term-label" />
                                <ui:DropdownField name="DrpChartWeekSelector" class="term-dropdown" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- PHASE (ĐỢT) DATE RANGE - HIDDEN -->
                        <ui:VisualElement name="PhaseBar" class="phase-bar" style="display: none;">
                            <ui:VisualElement class="phase-block">
                                <ui:Label text="Đợt 1" class="term-label" />
                                <ui:VisualElement class="phase-row">
                                    <ui:VisualElement class="date-field">
                                        <ui:Label text="Từ (dd/MM/yyyy)" class="mini-label" />
                                        <ui:TextField name="InpPhase1Start" class="date-input" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="date-field">
                                        <ui:Label text="Đến (dd/MM/yyyy)" class="mini-label" />
                                        <ui:TextField name="InpPhase1End" class="date-input" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement class="phase-block">
                                <ui:Label text="Đợt 2" class="term-label" />
                                <ui:VisualElement class="phase-row">
                                    <ui:VisualElement class="date-field">
                                        <ui:Label text="Từ (dd/MM/yyyy)" class="mini-label" />
                                        <ui:TextField name="InpPhase2Start" class="date-input" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="date-field">
                                        <ui:Label text="Đến (dd/MM/yyyy)" class="mini-label" />
                                        <ui:TextField name="InpPhase2End" class="date-input" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>


                         <!-- Row 1: Charts + Rankings (New Layout) -->
                        <ui:VisualElement style="flex-direction: row; margin-bottom: 20px;">

                            <!-- LEFT: Charts -->
                            <ui:VisualElement style="flex: 1; margin-right: 10px;">

                                <!-- Chart A: Tổng quan (100% stacked bar) -->
                                <ui:VisualElement class="dashboard-card" style="height: 150px; margin-bottom: 14px;">
                                    <ui:Label text="Tổng quan điểm danh (đã chốt)" class="card-title" style="margin-bottom: 10px;" />

                                    <!-- stacked bar will be drawn by C# -->
                                    <ui:VisualElement name="PieChartContainer" style="width: 100%; height: 28px;" />

                                    <!-- legend + values -->
                                    <ui:VisualElement style="flex-direction: row; margin-top: 10px;">
                                        <ui:VisualElement style="flex: 1; flex-direction: row; align-items: center;">
                                            <ui:VisualElement style="width: 10px; height: 10px; background-color: #00b894; border-radius: 2px; margin-right: 6px;" />
                                            <ui:Label text="Đúng giờ" style="color: #636E72; font-size: 12px;" />
                                            <ui:Label name="LblPiePresent" text="0%" style="margin-left: auto; -unity-font-style: bold; color: #2d3436; font-size: 12px;" />
                                        </ui:VisualElement>

                                        <ui:VisualElement style="flex: 1; flex-direction: row; align-items: center; margin-left: 12px;">
                                            <ui:VisualElement style="width: 10px; height: 10px; background-color: #d63031; border-radius: 2px; margin-right: 6px;" />
                                            <ui:Label text="Trễ" style="color: #636E72; font-size: 12px;" />
                                            <ui:Label name="LblPieLate" text="0%" style="margin-left: auto; -unity-font-style: bold; color: #2d3436; font-size: 12px;" />
                                        </ui:VisualElement>

                                        <ui:VisualElement style="flex: 1; flex-direction: row; align-items: center; margin-left: 12px;">
                                            <ui:VisualElement style="width: 10px; height: 10px; background-color: #fdcb6e; border-radius: 2px; margin-right: 6px;" />
                                            <ui:Label text="Vắng" style="color: #636E72; font-size: 12px;" />
                                            <ui:Label name="LblPieAbsent" text="0%" style="margin-left: auto; -unity-font-style: bold; color: #2d3436; font-size: 12px;" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>

                                    <ui:Label name="LblOverviewHint" text="" style="margin-top: 8px; font-size: 11px; color: #636E72;" />
                                </ui:VisualElement>

                                <!-- Chart B: Xu hướng % có mặt (10 tuần) -->
                                <ui:VisualElement class="dashboard-card" style="height: 180px;">
                                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                        <ui:Label text="Xu hướng % có mặt (10 tuần)" class="card-title" />
                                        <ui:Label name="LblWeeklyTrendValue" text="" class="card-title" style="color: #0984E3; font-size: 12px;" />
                                    </ui:VisualElement>

                                    <!-- line chart drawn by C# -->
                                    <ui:VisualElement name="WeeklyTrendCanvas" style="width: 100%; height: 120px;" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- RIGHT: Rankings -->
                            <ui:VisualElement style="flex: 1; margin-left: 10px;">
                                <ui:VisualElement class="dashboard-card" style="height: 170px; margin-bottom: 14px;">
                                    <ui:Label text="Top Hay Trễ ⏰" class="card-title" style="color: #D63031;" />
                                    <ui:ListView name="ListTopLate" item-height="40" style="flex-grow: 1; margin-top: 10px;" />
                                </ui:VisualElement>

                                <ui:VisualElement class="dashboard-card" style="height: 170px;">
                                    <ui:Label text="Top Hay Vắng 🚫" class="card-title" style="color: #fdcb6e;" />
                                    <ui:ListView name="ListTopAbsent" item-height="40" style="flex-grow: 1; margin-top: 10px;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>


                        <!-- Row 2.5: Latency (NEW) -->
                        <ui:VisualElement class="dashboard-card" style="min-height: 240px; margin-bottom: 20px; padding: 18px;">
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
